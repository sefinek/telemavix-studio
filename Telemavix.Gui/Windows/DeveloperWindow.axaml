<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Telemavix.Gui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="760"
        x:Class="Telemavix.Gui.DeveloperWindow"
        Width="980" Height="760" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="{x:Static local:AppAssets.Icon}"
        Title="Developer tools">

	<Window.Styles>
		<Style Selector="WrapPanel > Button">
			<Setter Property="Margin" Value="0,0,8,8" />
		</Style>
	</Window.Styles>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="20" Spacing="12">
			<StackPanel Spacing="2">
				<TextBlock Text="Developer tools" FontSize="18" FontWeight="SemiBold" />
				<TextBlock Classes="hint" Text="Shows the dialogs and notifications the app has, with their real texts and sample data, without doing anything. Ctrl+Shift+D opens this window." />
			</StackPanel>

			<Border Classes="card" Padding="14,12,6,4">
				<StackPanel Spacing="8">
					<TextBlock Text="RECORDING AND RENDER" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="Render complete" Tag="render-done" Click="OnActionClick" />
						<Button Content="Render failed" Tag="render-failed" Click="OnActionClick" />
						<Button Content="Not enough disk space" Tag="disk-space" Click="OnActionClick" />
						<Button Content="Busy GPU before a render" Tag="busy:gpu" Click="OnActionClick" />
						<Button Content="Busy CPU before a render" Tag="busy:cpu" Click="OnActionClick" />
						<Button Content="Busy CPU before a GPU render" Tag="busy:gpu-cpu" Click="OnActionClick" />
						<Button Content="Render already running" Tag="render-busy" Click="OnActionClick" />
						<Button Content="Close while rendering" Tag="close-rendering" Click="OnActionClick" />
						<Button Content="Export rights" Tag="export-notice" Click="OnActionClick" />
						<Button Content="DJI API terms" Tag="dji-api-notice" Click="OnActionClick" />
					</WrapPanel>
					<TextBlock Text="RENDER QUEUE" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="Queue window" Tag="queue" Click="OnActionClick" />
						<Button Content="Queue finished" Tag="queue-finished" Click="OnActionClick" />
						<Button Content="Queue finished partly" Tag="queue-finished-partly" Click="OnActionClick" />
						<Button Content="Queue busy" Tag="queue-busy" Click="OnActionClick" />
						<Button Content="Separate or joined" Tag="queue-recordings" Click="OnActionClick" />
					</WrapPanel>
					<TextBlock Text="RECORDING AND TELEMETRY" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="No telemetry" Tag="no-telemetry" Click="OnActionClick" />
						<Button Content="No GPS" Tag="no-gps" Click="OnActionClick" />
						<Button Content="Track failed" Tag="track-failed" Click="OnActionClick" />
						<Button Content="Telemetry export failed" Tag="telemetry-export-failed" Click="OnActionClick" />
						<Button Content="Music cannot be used" Tag="music-cant-use" Click="OnActionClick" />
						<Button Content="Settings preset picker" Tag="config-preset-picker" Click="OnActionClick" />
						<Button Content="Track preview format" Tag="track-format" Click="OnActionClick" />
					</WrapPanel>
				</StackPanel>
			</Border>

			<Border Classes="card" Padding="14,12,6,4">
				<StackPanel Spacing="8">
					<TextBlock Text="PROJECTS AND PRESETS" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="New project" Tag="new-project" Click="OnActionClick" />
						<Button Content="Unsaved changes" Tag="unsaved" Click="OnActionClick" />
						<Button Content="Project overlay differs" Tag="project-overlay" Click="OnActionClick" />
						<Button Content="Save failed" Tag="project-save-failed" Click="OnActionClick" />
						<Button Content="Open failed" Tag="project-open-failed" Click="OnActionClick" />
						<Button Content="Delete preset" Tag="preset-delete" Click="OnActionClick" />
						<Button Content="Reset preset" Tag="preset-reset" Click="OnActionClick" />
						<Button Content="Delete layer" Tag="layer-delete" Click="OnActionClick" />
					</WrapPanel>
					<TextBlock Text="UPDATES AND DEPENDENCIES" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="Update available" Tag="update-available" Click="OnActionClick" />
						<Button Content="Update available (download)" Tag="update-available-download" Click="OnActionClick" />
						<Button Content="Confirm update" Tag="update-confirm" Click="OnActionClick" />
						<Button Content="Update while rendering" Tag="update-rendering" Click="OnActionClick" />
						<Button Content="Update failed" Tag="update-failed" Click="OnActionClick" />
						<Button Content="Access switched off" Tag="remote-access" Click="OnActionClick" />
						<Button Content="Dependency update" Tag="deps-update" Click="OnActionClick" />
						<Button Content="Dependency update while rendering" Tag="deps-rendering" Click="OnActionClick" />
					</WrapPanel>
					<TextBlock Text="TOOLS" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="Replace test recording" Tag="test-recording" Click="OnActionClick" />
						<Button Content="Test recording while rendering" Tag="test-recording-rendering" Click="OnActionClick" />
						<Button Content="Fix tags: ask" Tag="tools-fix-ask" Click="OnActionClick" />
						<Button Content="Fix tags: nothing to do" Tag="tools-fix-nothing" Click="OnActionClick" />
						<Button Content="Fix tags: done" Tag="tools-fix-done" Click="OnActionClick" />
						<Button Content="Fix tags: failed" Tag="tools-fix-failed" Click="OnActionClick" />
						<Button Content="Metadata removed" Tag="tools-metadata-done" Click="OnActionClick" />
						<Button Content="Metadata failed" Tag="tools-metadata-failed" Click="OnActionClick" />
						<Button Content="Audio: replace" Tag="tools-audio-replace" Click="OnActionClick" />
						<Button Content="Audio: done" Tag="tools-audio-done" Click="OnActionClick" />
						<Button Content="Audio: failed" Tag="tools-audio-failed" Click="OnActionClick" />
						<Button Content="Compare: limit" Tag="compare-limit" Click="OnActionClick" />
						<Button Content="Compare: open failed" Tag="compare-open-failed" Click="OnActionClick" />
					</WrapPanel>
				</StackPanel>
			</Border>

			<Border Classes="card" Padding="14,12,6,4">
				<StackPanel Spacing="8">
					<TextBlock Text="NOTIFICATIONS" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="Balloon" Tag="balloon" Click="OnActionClick" />
						<Button Content="Balloon in 3 s" Tag="balloon-later" Click="OnActionClick" />
						<Button Content="Log: info" Tag="log:info" Click="OnActionClick" />
						<Button Content="Log: warning" Tag="log:warn" Click="OnActionClick" />
						<Button Content="Log: error" Tag="log:error" Click="OnActionClick" />
					</WrapPanel>
					<TextBlock Text="SOUNDS" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="Question" Tag="sound:Question" Click="OnActionClick" />
						<Button Content="Info" Tag="sound:Info" Click="OnActionClick" />
						<Button Content="Success" Tag="sound:Success" Click="OnActionClick" />
						<Button Content="Warning" Tag="sound:Warning" Click="OnActionClick" />
						<Button Content="Error" Tag="sound:Error" Click="OnActionClick" />
						<Button Content="Render complete" Tag="sound:RenderComplete" Click="OnActionClick" />
					</WrapPanel>
					<TextBlock Text="TASKBAR PROGRESS (WINDOWS)" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="Normal 40%" Tag="taskbar:Normal" Click="OnActionClick" />
						<Button Content="Indeterminate" Tag="taskbar:Indeterminate" Click="OnActionClick" />
						<Button Content="Paused" Tag="taskbar:Paused" Click="OnActionClick" />
						<Button Content="Error" Tag="taskbar:Error" Click="OnActionClick" />
						<Button Content="None" Tag="taskbar:NoProgress" Click="OnActionClick" />
					</WrapPanel>
				</StackPanel>
			</Border>

			<Border Classes="card" Padding="14,12,6,4">
				<StackPanel Spacing="8">
					<TextBlock Text="WINDOWS" Classes="sectionLabel" />
					<WrapPanel>
						<Button Content="Welcome (first run)" Tag="welcome" Click="OnActionClick" />
						<Button Content="Missing dependencies" Tag="dependencies" Click="OnActionClick" />
						<Button Content="Performance test result" Tag="benchmark" Click="OnActionClick" />
						<Button Content="External GPS track" Tag="external-track" Click="OnActionClick" />
					</WrapPanel>
				</StackPanel>
			</Border>

			<TextBlock Name="StatusText" Classes="hint" />
		</StackPanel>
	</ScrollViewer>
</Window>
